    <!-- 06. RESEARCH & PUBLICATIONS -->
    <section class="section research" id="research" aria-labelledby="research-title">
      <div class="container">
        <header class="sec-head">
          <span class="sec-head__index" aria-hidden="true">06</span>
          <span class="sec-head__rule" aria-hidden="true"></span>
          <h2 class="sec-head__title" id="research-title">Research &amp; Publications</h2>
        </header>
        <div class="research__grid">
          <div class="research__text">
            <h3 class="research__publication">
              Explainable AI Supported Evaluation and Comparison on Credit Card Fraud Detection Models
            </h3>
            <dl class="research__meta">
              <div><dt>Role</dt><dd>First Author &amp; Presenter</dd></div>
              <div><dt>Conference</dt><dd>7th International Conference on Information Technology (InCIT 2023) · IEEE</dd></div>
              <div><dt>Venue</dt><dd>Mae Fah Luang University · Chiang Rai, Thailand · Nov 2023</dd></div>
              <div><dt>Published</dt><dd>IEEE · Jan 30, 2024</dd></div>
              <div><dt>Context</dt><dd>National Central University × Mahidol University</dd></div>
            </dl>
            <p class="research__note">
              The paper evaluates four fraud-detection models — K-Nearest Neighbors, Random Forest,
              XGBoost and Logistic Regression — and uses SHAP to make their predictions interpretable,
              turning model output into insight that both business and technical stakeholders can act on.
            </p>
            <p class="research__links">
              <a href="https://doi.org/10.1109/InCIT60207.2023.10413100" target="_blank" rel="noopener noreferrer" class="research__link">View publication <span aria-hidden="true">↗</span></a>
              <a href="/documents/posters/incit-2023.pdf" target="_blank" rel="noopener noreferrer" class="research__link research__link--quiet">View poster (PDF) <span aria-hidden="true">↗</span></a>
            </p>
          </div>
          <div class="research__visual">
            <figure class="research__photo">
              <img src="/assets/moments/incit-presentation.jpg"
                   alt="Chanisara at the InCIT 2023 conference venue, Mae Fah Luang University, Chiang Rai"
                   width="960" height="1280" loading="lazy">
              <figcaption>InCIT 2023 · Chiang Rai</figcaption>
            </figure>
            <figure class="research__doc">
              <img src="/assets/projects/fraud-detection/visualization.png"
                   alt="Presentation title slide listing the paper’s authors, Mahidol University and National Central University"
                   width="1861" height="1049" loading="lazy">
              <figcaption>Mahidol University × National Central University</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

