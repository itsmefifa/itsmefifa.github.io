<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Primary SEO -->
  <title>Chanisara Kotrachai — Business × Technology × Delivery</title>
  <meta name="description" content="Personal digital exhibition of Chanisara Kotrachai — Technical Project Manager and Business Analyst working across requirements, software, quality, data and AI. Experience, selected work, IEEE research, certifications and professional archive.">
  <link rel="canonical" href="https://itsmefifa.github.io/">

  <!-- Open Graph -->
  <meta property="og:title" content="Chanisara Kotrachai — Business × Technology × Delivery">
  <meta property="og:description" content="A personal digital exhibition: experience, selected work, IEEE research, certifications, honors and professional archive of Chanisara Kotrachai.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://itsmefifa.github.io/">
  <meta property="og:image" content="https://itsmefifa.github.io/assets/og/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Chanisara Kotrachai — Business, Technology, Delivery, on a white branded card">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Chanisara Kotrachai — Business × Technology × Delivery">
  <meta name="twitter:description" content="A personal digital exhibition: experience, selected work, IEEE research, certifications, honors and professional archive.">
  <meta name="twitter:image" content="https://itsmefifa.github.io/assets/og/og-image.png">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">

  <meta name="theme-color" content="#FFFFFF">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- Navigation -->
  <header class="nav" id="top">
    <div class="container nav__inner">
      <a href="#top" class="nav__logo">Chanisara<span class="nav__dot" aria-hidden="true"></span></a>
      <nav id="nav-links" class="nav__menu" aria-label="Primary">
        <a href="#experience" class="nav__link">Experience</a>
        <a href="#work" class="nav__link">Work</a>
        <a href="#research" class="nav__link">Research</a>
        <a href="#archive" class="nav__link">Archive</a>
        <a href="#contact" class="nav__link">Contact</a>
      </nav>
      <button class="nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main">

    <!-- 01. INTRODUCTION -->
    <section class="section hero" id="introduction" aria-label="Introduction">
      <div class="container hero__grid">
        <div class="hero__text">
          <p class="kicker"><span class="kicker__tick" aria-hidden="true"></span>Business × Technology × Delivery</p>
          <h1 class="hero__name">Chanisara<br>Kotrachai</h1>
          <p class="hero__lede">
            I work in the space between business needs and technical execution —
            turning requirements into working software, and working software into delivered value.
          </p>
          <a href="#work" class="hero__cta">Explore my work <span aria-hidden="true">↓</span></a>
          <p class="hero__meta">Bangkok, Thailand</p>
        </div>
        <figure class="hero__portrait">
          <img src="/assets/profile/Chanisara_Hero.jpg" alt="Portrait of Chanisara Kotrachai" width="960" height="1280" fetchpriority="high">
        </figure>
      </div>
    </section>

    <!-- 02. BUSINESS × TECHNOLOGY × DELIVERY -->
    <section class="section bridge" id="bridge" aria-labelledby="bridge-title">
      <div class="container">
        <header class="sec-head">
          <span class="sec-head__index" aria-hidden="true">02</span>
          <span class="sec-head__rule" aria-hidden="true"></span>
          <h2 class="sec-head__title" id="bridge-title">Business × Technology × Delivery</h2>
        </header>
        <div class="axis">
          <span class="axis__end" aria-hidden="true"></span>
          <div class="axis__node">
            <h3 class="axis__label">Business</h3>
            <ul class="axis__list">
              <li>Requirements</li>
              <li>Process</li>
              <li>Stakeholders</li>
              <li>Business Logic</li>
              <li>User Needs</li>
            </ul>
          </div>
          <div class="axis__node">
            <h3 class="axis__label">Technology</h3>
            <ul class="axis__list">
              <li>Systems</li>
              <li>APIs</li>
              <li>Software</li>
              <li>Data</li>
              <li>AI</li>
              <li>Automation</li>
            </ul>
          </div>
          <div class="axis__node">
            <h3 class="axis__label">Delivery</h3>
            <ul class="axis__list">
              <li>Planning</li>
              <li>Coordination</li>
              <li>Validation</li>
              <li>Release</li>
              <li>Risk / Issue Management</li>
            </ul>
          </div>
        </div>
        <p class="bridge__lede">
          Digital products are built in the gaps between these three.
          My work is making sure they connect.
        </p>
      </div>
    </section>

    <!-- 03. EXPERIENCE -->
    <section class="section experience" id="experience" aria-labelledby="experience-title">
      <div class="container">
        <header class="sec-head">
          <span class="sec-head__index" aria-hidden="true">03</span>
          <span class="sec-head__rule" aria-hidden="true"></span>
          <h2 class="sec-head__title" id="experience-title">Experience</h2>
        </header>

        <div class="xp-list">
          <article class="xp xp--now">
            <div class="xp__when">
              <p class="xp__dates">Jan 2026 — Present</p>
              <p class="xp__place">Bangkok, Thailand · Hybrid</p>
            </div>
            <div class="xp__body">
              <p class="xp__verb">Connect &amp; Deliver</p>
              <h3 class="xp__role">Technology Project Manager</h3>
              <p class="xp__org">Data Wow · Full-time</p>
              <p class="xp__summary">
                Defining project scope, objectives, timelines and deliverables with stakeholders,
                and coordinating delivery across developers, QA and business users through every phase.
              </p>
              <details class="xp__more">
                <summary>Full responsibilities</summary>
                <ul>
                  <li>Defined project scope, objectives, timelines, deliverables, and documentation in collaboration with stakeholders and project teams.</li>
                  <li>Developed and managed detailed project plans across all phases, including resource planning, milestone tracking, and delivery coordination.</li>
                  <li>Monitored project progress, dependencies, risks, issues, and blockers, and drove timely resolution to support project success.</li>
                  <li>Organized project meetings, sprint planning, progress updates, demos, and follow-up actions, ensuring clear communication across stakeholders.</li>
                  <li>Supported backlog prioritization, change management, process improvement, and project quality throughout the delivery lifecycle.</li>
                </ul>
              </details>
            </div>
          </article>

          <article class="xp xp--lead">
            <div class="xp__when">
              <p class="xp__dates">Jun 2024 — Dec 2025</p>
              <p class="xp__place">Thailand</p>
            </div>
            <div class="xp__body">
              <p class="xp__verb">Connect &amp; Deliver</p>
              <h3 class="xp__role">Tech Project Management Associate</h3>
              <p class="xp__org">Bitkub · Thailand’s Digital Asset Exchange · Full-time</p>
              <p class="xp__summary">
                Gathered business requirements and translated them into functional specifications, SRS,
                workflows and prototypes; created and executed test cases, and supported post-launch
                incident analysis and resolution with technical teams.
                <a class="xref" href="#moments">Bitkub Summit 2024 ↓</a>
              </p>
              <details class="xp__more">
                <summary>Full responsibilities</summary>
                <ul>
                  <li>Collaborated directly with stakeholders to gather business requirements, translating them into functional specifications and comprehensive project documentation.</li>
                  <li>Designed and validated functional specifications, system flows, business logic, and user interface design.</li>
                  <li>Developed detailed workflows and Software Requirements Specifications (SRS) to facilitate implementation.</li>
                  <li>Created visual mock-ups and prototypes to demonstrate user interface designs, improve stakeholder comprehension, and facilitate feedback.</li>
                  <li>Developed and executed test cases to validate functionality and alignment with business goals and technical requirements.</li>
                  <li>Created operational processes including training, demonstrations, and user manuals.</li>
                  <li>Provided post-launch support through incident analysis, root-cause identification, and technical team coordination for problem resolution.</li>
                </ul>
              </details>
            </div>
          </article>

          <article class="xp">
            <div class="xp__when">
              <p class="xp__dates">Jan 2024 — Apr 2024</p>
              <p class="xp__place">Bangkok, Thailand · Hybrid</p>
            </div>
            <div class="xp__body">
              <p class="xp__verb">Validate</p>
              <h3 class="xp__role">Quality Assurance Tester</h3>
              <p class="xp__org">Social+ · Internship</p>
              <p class="xp__summary">
                Designed and executed comprehensive manual, automated, and API test cases for mobile
                and web platforms, ensuring functionality and adherence to project requirements.
              </p>
            </div>
          </article>

          <article class="xp">
            <div class="xp__when">
              <p class="xp__dates">Jun 2023 — Jul 2023</p>
              <p class="xp__place">Taoyuan City, Taiwan · On-site</p>
            </div>
            <div class="xp__body">
              <p class="xp__verb">Understand</p>
              <h3 class="xp__role">Research Intern</h3>
              <p class="xp__org">National Central University</p>
              <p class="xp__summary">
                Applied machine-learning models to credit card fraud detection, comparing four models
                with a focus on performance and interpretability, and used SHAP to analyze predictions
                and feature importance. Published in the proceedings of InCIT 2023.
                <a class="xref" href="#research">Read the publication ↓</a>
              </p>
            </div>
          </article>

          <article class="xp">
            <div class="xp__when">
              <p class="xp__dates">Jun 2022 — Jul 2022</p>
              <p class="xp__place">Bangkok, Thailand</p>
            </div>
            <div class="xp__body">
              <p class="xp__verb">Build</p>
              <h3 class="xp__role">Software Developer Intern</h3>
              <p class="xp__org">CP Match</p>
              <p class="xp__summary">
                Developed frontend applications using React and JavaScript while adapting to changing
                requirements in an Agile environment, working on frontend development and a Content
                Management System.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 04. SELECTED WORK -->
    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="container">
        <header class="sec-head">
          <span class="sec-head__index" aria-hidden="true">04</span>
          <span class="sec-head__rule" aria-hidden="true"></span>
          <h2 class="sec-head__title" id="work-title">Selected Work</h2>
        </header>

        <!-- Project 01 -->
        <article class="project" id="project-fraud">
          <header class="project__head">
            <span class="project__no" aria-hidden="true">01</span>
            <span class="project__cat">Applied Machine Learning · IEEE Publication</span>
          </header>
          <h3 class="project__title">Explainable AI for<br>Credit Card Fraud Detection</h3>
          <div class="project__grid">
            <div class="project__text">
              <p class="project__lede">How can a fraud-detection model be trusted if it cannot be explained?</p>
              <p class="project__body-text">
                Evaluated four machine-learning models on credit card fraud detection, then applied SHAP
                to translate model behaviour into interpretable insight for business and technical
                stakeholders. The work became a peer-reviewed IEEE publication, presented at InCIT 2023.
              </p>
              <dl class="project__meta">
                <div><dt>Role</dt><dd>First Author &amp; Presenter</dd></div>
                <div><dt>Models</dt><dd>KNN · Random Forest · XGBoost · Logistic Regression</dd></div>
                <div><dt>Explainability</dt><dd>SHAP</dd></div>
                <div><dt>Venue</dt><dd>IEEE InCIT 2023 · Chiang Rai</dd></div>
              </dl>
              <p class="project__xref"><a class="xref" href="#research">Publication &amp; conference ↓</a></p>
            </div>
            <figure class="project__media">
              <img src="/assets/projects/fraud-detection/visualization.png"
                   alt="Title slide of the paper “Explainable AI Supported Evaluation and Comparison on Credit Card Fraud Detection Models”, presented at InCIT 2023"
                   width="1861" height="1049" loading="lazy">
              <figcaption>Paper title slide · InCIT 2023</figcaption>
            </figure>
          </div>
        </article>

        <!-- Project 02 -->
        <article class="project project--alt" id="project-cocoa">
          <header class="project__head">
            <span class="project__no" aria-hidden="true">02</span>
            <span class="project__cat">Computer Vision · Final Year Project</span>
          </header>
          <h3 class="project__title">Automatic Grading<br>Assessment of Cocoa Seeds</h3>
          <div class="project__grid">
            <div class="project__text">
              <p class="project__lede">Grading cocoa seeds by hand is slow and inconsistent.</p>
              <p class="project__body-text">
                My undergraduate final-year project implemented YOLOv5 and YOLOv8 to automate grading
                through image recognition — carried from user requirements to a working AI prototype
                with measurable output and practical use-case relevance.
              </p>
              <dl class="project__meta">
                <div><dt>Approach</dt><dd>YOLOv5 · YOLOv8</dd></div>
                <div><dt>Scope</dt><dd>Requirements analysis → AI prototype</dd></div>
                <div><dt>Context</dt><dd>Mahidol University · 2024</dd></div>
              </dl>
              <p class="project__xref"><a class="xref" href="#education">Final-year project · Mahidol University ↓</a></p>
            </div>
            <div class="project__media">
              <div class="project__cluster">
                <img
                  class="project__asset project__asset--wide"
                  src="assets/projects/cocoa/coco_1.jpg"
                  alt="YOLO detection output for automatic grading assessment of cocoa seeds"
                  loading="lazy"
                  decoding="async"
                >
                <div class="project__cluster-row">
                  <!-- <img
                    class="project__asset project__asset--small"
                    src="assets/projects/cocoa/sample.webp"
                    alt="Sample cocoa seeds used in the project"
                    loading="lazy"
                    decoding="async"
                  >
                  <img
                    class="project__asset project__asset--small"
                    src="assets/projects/cocoa/results.webp"
                    alt="Model performance results for cocoa seed grading"
                    loading="lazy"
                    decoding="async"
                  > -->
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- Project 03 -->
        <article class="project" id="project-gemini">
          <header class="project__head">
            <span class="project__no" aria-hidden="true">03</span>
            <span class="project__cat">Systems Design &amp; Development</span>
          </header>
          <h3 class="project__title">Gemini</h3>
          <div class="project__grid">
            <div class="project__text">
              <p class="project__lede">From requirements on paper to a deployed application.</p>
              <p class="project__body-text">
                A full pass through the software lifecycle: business and technical requirements
                structured into Use Case, Activity, Sequence and Class diagrams, then implemented
                and deployed as a web application.
              </p>
              <dl class="project__meta">
                <div><dt>Stack</dt><dd>Java · Spring Boot · Docker · Render</dd></div>
                <div><dt>Design</dt><dd>Use Case · Activity · Sequence · Class diagrams</dd></div>
                <div><dt>Path</dt><dd>Requirements → design → implementation</dd></div>
              </dl>
              <p class="project__xref"><a class="xref" href="https://github.com/itsmefifa/ITCS431_Software-Design-and-Development" target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a></p>
            </div>
            <div class="project__media">
              <div class="project__cluster">
                <img
                  class="project__asset project__asset--wide"
                  src="assets/projects/gemini/gemini.png"
                  alt="Screenshot of the Gemini application"
                  loading="lazy"
                  decoding="async"
                >
                <div class="project__cluster-row project__cluster-row--contain">
                  <figure>
                    <img
                      src="assets/projects/gemini/Genimi_4_use_case.png"
                      alt="Use case diagram — Gemini system scope and user interactions"
                      loading="lazy"
                      decoding="async"
                    >
                    <figcaption><strong>Use Case</strong> / System scope and user interactions</figcaption>
                  </figure>
                  <figure>
                    <img
                      src="assets/projects/gemini/Gemini4_Class_Diagram.png"
                      alt="Class diagram — Gemini application structure and domain relationships"
                      loading="lazy"
                      decoding="async"
                    >
                    <figcaption><strong>Class Diagram</strong> / Application structure and domain relationships</figcaption>
                  </figure>
                </div>
                <p class="project__xref"><a class="xref" href="https://github.com/itsmefifa/ITCS431_Software-Design-and-Development/tree/main/Gemini/design" target="_blank" rel="noopener noreferrer">View full design artifacts ↗</a></p>
              </div>
            </div>
          </div>
        </article>

        <!-- Project 04 -->
        <article class="project project--alt" id="project-jelly">
          <header class="project__head">
            <span class="project__no" aria-hidden="true">04</span>
            <span class="project__cat">Quality Engineering &amp; Test Automation</span>
          </header>
          <h3 class="project__title">Jelly Translator</h3>
          <div class="project__grid">
            <div class="project__text">
              <p class="project__lede">Quality is a system, not a final step.</p>
              <p class="project__body-text">
                A quality-engineering study of a translation application: requirements traced through
                a Requirements Traceability Matrix, automation with Robot Framework and Pytest,
                and continuous integration with GitHub Actions.
              </p>
              <dl class="project__meta">
                <div><dt>Automation</dt><dd>Robot Framework · Pytest</dd></div>
                <div><dt>Traceability</dt><dd>Requirements Traceability Matrix</dd></div>
                <div><dt>Pipeline</dt><dd>GitHub Actions</dd></div>
              </dl>
              <p class="project__xref"><a class="xref" href="https://github.com/itsmefifa/2023-ITCS473-GluayGluay" target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a> · <a class="xref" href="https://github.com/itsmefifa/2023-ITCS473-GluayGluay/actions" target="_blank" rel="noopener noreferrer">GitHub Actions ↗</a></p>
            </div>
            <div class="project__media">
              <div class="project__cluster">
                <img
                  class="project__asset project__asset--wide"
                  src="assets/projects/Jelly/QA_2.png"
                  alt="Screenshot of the Jelly Translator application"
                  loading="lazy"
                  decoding="async"
                >
                <div class="project__cluster-row project__cluster-row--asym project__cluster-row--contain">
                  <figure>
                    <img
                      src="assets/projects/jelly/UI_REPORT.png"
                      alt="Robot Framework automated UI test report for Jelly Translator"
                      loading="lazy"
                      decoding="async"
                    >
                    <figcaption class="project__cap">
                      <strong>Automated UI Test Report</strong>
                      <span>Robot Framework · end-to-end UI validation</span>
                    </figcaption>
                  </figure>
                  <figure>
                    <img
                      src="assets/projects/jelly/rtm.png"
                      alt="Requirements traceability matrix for Jelly Translator"
                      loading="lazy"
                      decoding="async"
                    >
                    <figcaption class="project__cap">
                      <strong>Requirements Traceability Matrix</strong>
                      <span>Requirements → test scenarios → validation</span>
                    </figcaption>
                  </figure>
                </div>
              </div>
            </div>
          </div>
        </article>

        <p class="work__more">
          The wider project history — testing, data, web and concept work — lives in the
          <a class="xref" href="#archive">Project Archive ↓</a>
        </p>
      </div>
    </section>

    <!-- 05. PROJECT ARCHIVE -->
    <section class="section catalog" id="archive" aria-labelledby="archive-title">
      <div class="container">
        <header class="sec-head">
          <span class="sec-head__index" aria-hidden="true">05</span>
          <span class="sec-head__rule" aria-hidden="true"></span>
          <h2 class="sec-head__title" id="archive-title">Project Archive</h2>
        </header>
        <p class="catalog__lede">Breadth, after depth — the wider project history, indexed by year.</p>

        <div class="catalog__group">
          <h3 class="catalog__year">2023</h3>
          <ul class="catalog__list">
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Jelly Translator <a class="xref" href="#project-jelly">case study ↑</a></h4>
                <p class="catalog__desc">Testing project for an existing translation web application (original application by Siranut Akarawuthi): unit, system and UI test automation with coverage and CI/CD.</p>
                <p class="catalog__stack">Pytest · Robot Framework · GitHub Actions — Mahidol University, Oct–Dec 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">Quality Engineering</span>
                <a class="catalog__link" href="https://github.com/itsmefifa/2023-ITCS473-GluayGluay/tree/master/Project_phase_2" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">NYC Vehicle Collisions Explorer</h4>
                <p class="catalog__desc">Interactive Streamlit application for exploring New York City motor-vehicle collision data: locations, timing, injured-person filtering and minute-level breakdowns.</p>
                <p class="catalog__stack">Streamlit · interactive data visualization — Mahidol University, Oct 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">Data Visualization</span>
                <a class="catalog__link" href="https://github.com/itsmefifa/NYC-Vehicle-Collisions" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Sudoku Testing</h4>
                <p class="catalog__desc">Testing enhancement of an open-source Sudoku application: test design, edge-case testing and continuous integration.</p>
                <p class="catalog__stack">JUnit · Gradle · GitHub Actions — Mahidol University, Aug–Oct 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">Quality Engineering</span>
                <a class="catalog__link" href="https://github.com/itsmefifa/2023-ITCS473-GluayGluay" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Explainable AI Fraud Detection <a class="xref" href="#research">publication ↓</a></h4>
                <p class="catalog__desc">Machine-learning fraud-detection research with SHAP explainability, published at IEEE InCIT 2023.</p>
                <p class="catalog__stack">KNN · Random Forest · XGBoost · Logistic Regression · SHAP — National Central University, Jun–Jul 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">ML Research</span>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Gemini <a class="xref" href="#project-gemini">case study ↑</a></h4>
                <p class="catalog__desc">Software engineering project for a telescope science-plan system: requirements, UML design (Use Case, Activity, Sequence, Class), implementation and deployment.</p>
                <p class="catalog__stack">Java · Spring Boot · Docker · Render — Mahidol University, Jan–May 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">Software Engineering</span>
                <a class="catalog__link" href="https://github.com/Waariss/ITCS431_Software-Design-and-Development/blob/main/Gemini/Gemini-4.md" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                <a class="catalog__link" href="https://gemini4.onrender.com/" target="_blank" rel="noopener noreferrer">App <span aria-hidden="true">↗</span></a>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Save &amp; Go</h4>
                <p class="catalog__desc">Motorcycle transportation service concept focused on security, reasonable fares and a user-friendly experience, developed through user stories and UX work.</p>
                <p class="catalog__stack">User stories · UX — Mahidol University, Jan–May 2023</p>
              </div>
              <div class="catalog__side">
                <span class="catalog__domain">UX / Product Concept</span>
              </div>
            </li>
            <li class="catalog__row">
              <div class="catalog__main">
                <h4 class="catalog__name">Secured Audio Player</h4>
